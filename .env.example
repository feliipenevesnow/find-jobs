# Copie este modelo para .env na raiz do projeto e edite apenas a cópia.
# No PowerShell: Copy-Item -LiteralPath .env-example -Destination .env
# Use o .env para credenciais. Cargos, stack, cidade e nota mínima ficam em config.yaml.

# GitHub Issues (opcional)
# Um token permite mais consultas por hora. Leitura de repositórios públicos basta.
GITHUB_TOKEN=

# Aderência ao currículo (opcional)
# AI_PROVIDER escolhe o serviço. AI_MODEL escolhe o modelo dentro dele.
# Para a análise gratuita, use um projeto Free sem faturamento vinculado.
# Crie a chave em https://aistudio.google.com/apikey e cole em GEMINI_API_KEY.
AI_PROVIDER=gemini
AI_MODEL=gemini-decision-1
GEMINI_API_KEY=

# Sem chave, a busca usa as regras locais. AI_PROVIDER=none também ativa esse modo.
# Alternativas: groq, openai e ollama. Ao trocar, ajuste também AI_MODEL.
# Ollama local usa o nome mostrado em "ollama list" e dispensa chave.
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
